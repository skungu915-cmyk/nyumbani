  "private": true,
  "description": "LiveHere Homes API — property marketplace with M-Pesa pay-to-unlock contact details",
  "type": "commonjs",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
