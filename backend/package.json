    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "nodemailer": "^10.0.10",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "sharp": "^0.35.4",
    "zod": "^3.23.8"
  },
