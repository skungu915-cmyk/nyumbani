# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is gitignored on purpose.

# ── App ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of THIS backend (used to build the M-Pesa callback URL, upload URLs, etc.)
BACKEND_PUBLIC_URL=http://localhost:4000
# Exact origin(s) the frontend is served from — CORS allowlist, comma-separated, no trailing slash
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080

# ── Database ─────────────────────────────────────────────────────
# postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
DATABASE_URL=postgresql://liveherehomes:changeme@localhost:5432/liveherehomes?schema=public

# ── Auth secrets ─────────────────────────────────────────────────
# Generate strong random secrets, e.g.: openssl rand -base64 48
# Use TWO DIFFERENT secrets for access vs refresh tokens.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-32-bytes
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-min-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Cookie settings for the refresh-token cookie
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
# Comma-separated list of trusted header used for double-submit CSRF check on cookie-based routes
CSRF_HEADER_NAME=x-livehere-csrf

# ── Password / account security ─────────────────────────────────
BCRYPT_COST=12
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# ── M-Pesa Daraja (Safaricom) ────────────────────────────────────
# Get sandbox credentials at https://developer.safaricom.co.ke
# NEVER expose these to the frontend. They are read server-side only.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=changeme
MPESA_CONSUMER_SECRET=changeme
MPESA_SHORTCODE=174379
MPESA_PASSKEY=changeme
# Must be a real, HTTPS, publicly reachable URL in production (Safaricom cannot reach localhost).
MPESA_CALLBACK_URL=https://your-domain.example.com/api/payments/mpesa/callback
# Optional hardening: comma-separated CIDR/IP allowlist for Safaricom's published callback IP ranges.
MPESA_CALLBACK_IP_ALLOWLIST=

# ── Platform business defaults (seed values; editable by admin afterwards) ──
UNLOCK_FEE_KES=1000
PLATFORM_FEE_PERCENT=3
REFERRAL_REWARD_KES=200

# ── Initial admin account (used only by prisma/seed.js, run once) ──
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PHONE=+254700000000
# Leave unset to force a random strong password to be generated and printed once at seed time.
SEED_ADMIN_PASSWORD=

# ── Email (for verification / password reset) ───────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LiveHere Homes <no-reply@example.com>"

# ── Uploads ──────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_PHOTO_MB=5
MAX_PHOTOS_PER_PROPERTY=10
MAX_VIDEO_MB=50
